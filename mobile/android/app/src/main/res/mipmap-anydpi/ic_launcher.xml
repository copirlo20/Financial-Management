<?xml version="1.0" encoding="utf-8"?>
<!-- Android 7 (no adaptive icons): the same gradient and wallet in a circle. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="#FF370C6F"
                android:centerColor="#FF6816A1"
                android:endColor="#FFB62EB0" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
